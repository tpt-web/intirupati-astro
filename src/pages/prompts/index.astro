---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const prompts = (await getCollection('prompts')).sort((a, b) => {
  return new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime();
});
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={`Devotional Prompts - ${SITE_TITLE}`}
      description="Creative devotional prompts for prayer journaling, shrine worship, and pilgrimage planning at Tirupati."
      image="/images/2026/05/Devotional-Prompt-Card.webp"
    />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <Header />
    <main class="py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <p class="text-sm font-semibold uppercase tracking-[.3em] text-amber-600">Devotional Prompts</p>
          <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">Prayer & Reflection Prompts</h1>
          <p class="mt-4 text-slate-600">Use these devotional prompts to deepen your prayers, journaling, and pilgrimage preparation through simple, reflective guidance.</p>
        </div>
        <div class="grid gap-8 lg:grid-cols-2">
          {prompts.map((post) => (
            <article class="group rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              <a href={`/prompts/${post.id}/`} class="block">
                <h2 class="text-xl font-semibold text-slate-900 group-hover:text-amber-600">{post.data.title}</h2>
                <p class="mt-3 text-slate-600">{post.data.description}</p>
              </a>
              <div class="mt-6 flex items-center justify-between text-sm text-slate-500">
                <span>{post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Draft'}</span>
                <a href={`/prompts/${post.id}/`} class="text-amber-600 font-semibold">Read</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
